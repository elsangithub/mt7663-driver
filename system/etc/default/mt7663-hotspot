# MediaTek MT7663 Hotspot Network Configuration
# FiberHome HG680-FJ (Amlogic S905X2 / Meson G12A)

# Gateway IP address and Subnet CIDR
AP_GATEWAY="192.168.4.1"
AP_NETMASK="255.255.255.0"
AP_CIDR="24"

# DHCP IP Range (starting host and ending host within the subnet)
DHCP_START="10"
DHCP_END="100"
DHCP_LEASE="12h"

# DNS Servers distributed via DHCP Option 6 (comma-separated IP addresses)
# Cloudflare: 1.1.1.1,1.0.0.1
# Google: 8.8.8.8,8.8.4.4
# AdGuard Anti-Ads: 94.140.14.14,94.140.15.15
DNS_SERVERS="1.1.1.1,8.8.8.8"

# Maximum MTU for MT7663 SoftAP
AP_MTU="1408"

# Wi-Fi Bandwidth Width (80, 40, or 20 MHz)
AP_WIDTH="80"

# Wi-Fi Security Mode (WPA2-PSK, WPA2-WPA3, WPA3, or OPEN)
AP_SECURITY="WPA2-PSK"

# Router Web UI Authentication Credentials
WEBUI_USER="admin"
WEBUI_PASS="admin"
