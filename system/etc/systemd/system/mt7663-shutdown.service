[Unit]
Description=Unbind MT7663 SDIO controller cleanly before reboot/shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if lsmod | grep -q "^wlan_mt7663"; then for d in /sys/bus/platform/drivers/*mmc*/ffe03000* /sys/bus/platform/drivers/*sd*/ffe03000*; do [ -e "$d" ] && echo "${d##*/}" > "$(dirname "$d")/unbind" 2>/dev/null || true; done; fi'
TimeoutStartSec=2

[Install]
WantedBy=shutdown.target reboot.target halt.target
