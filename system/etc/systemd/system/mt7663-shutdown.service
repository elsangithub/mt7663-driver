[Unit]
Description=Unbind MT7663 SDIO controller cleanly before reboot/shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for d in /sys/bus/platform/drivers/meson-gx-mmc/ffe03000*; do [ -e "$d" ] && echo "${d##*/}" > /sys/bus/platform/drivers/meson-gx-mmc/unbind 2>/dev/null || true; done'
TimeoutStartSec=2

[Install]
WantedBy=shutdown.target reboot.target halt.target
