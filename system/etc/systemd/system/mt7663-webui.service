[Unit]
Description=MediaTek MT7663 Router Web UI Dashboard
After=network.target mt7663-hotspot.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/lib/mt7663-webui
ExecStart=/usr/bin/python3 /usr/lib/mt7663-webui/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
