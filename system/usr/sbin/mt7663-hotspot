#!/bin/bash
# MediaTek MT7663 SoftAP / Hotspot Management Utility
# FiberHome HG680-FJ (Amlogic Meson G12A)

CONF_FILE="/etc/hostapd/hostapd-mt7663.conf"
HOSTAPD_PID="/run/mt7663-hostapd.pid"
DNSMASQ_PID="/run/mt7663-dnsmasq.pid"
AP_IF="ap0"
AP_IP="192.168.4.1/24"
AP_MTU="1408"

if [ "$(id -u)" -ne 0 ]; then
    echo "[ERROR] mt7663-hotspot must be run as root." >&2
    exit 1
fi

start_hotspot() {
    echo "Starting MT7663 SoftAP Hotspot on interface $AP_IF..."
    
    if ! command -v hostapd >/dev/null 2>&1; then
        echo "[ERROR] hostapd not found. Please install via: apt install hostapd" >&2
        exit 1
    fi
    if ! command -v dnsmasq >/dev/null 2>&1; then
        echo "[ERROR] dnsmasq not found. Please install via: apt install dnsmasq" >&2
        exit 1
    fi

    if ! ip link show "$AP_IF" >/dev/null 2>&1; then
        echo "[ERROR] Interface $AP_IF does not exist. Ensure wlan_mt7663_sdio module is loaded." >&2
        exit 1
    fi

    ip addr flush dev "$AP_IF" 2>/dev/null || true
    ip addr add "$AP_IP" dev "$AP_IF"
    ip link set "$AP_IF" mtu "$AP_MTU"
    ip link set "$AP_IF" up

    sysctl -w net.ipv4.ip_forward=1 >/dev/null
    
    UPSTREAM_IF=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n1)
    [ -z "$UPSTREAM_IF" ] && UPSTREAM_IF="eth0"
    
    iptables -t nat -C POSTROUTING -o "$UPSTREAM_IF" -j MASQUERADE 2>/dev/null || \
    iptables -t nat -A POSTROUTING -o "$UPSTREAM_IF" -j MASQUERADE

    if [ -f "$DNSMASQ_PID" ] && kill -0 "$(cat "$DNSMASQ_PID")" 2>/dev/null; then
        kill "$(cat "$DNSMASQ_PID")" 2>/dev/null || true
    fi
    dnsmasq -C /dev/null -p 0 -i "$AP_IF" --bind-interfaces \
        --dhcp-range=192.168.4.10,192.168.4.100,255.255.255.0,12h \
        --dhcp-option=3,192.168.4.1 \
        --dhcp-option=6,8.8.8.8,1.1.1.1 \
        --dhcp-option=26,1408 \
        --pid-file="$DNSMASQ_PID"

    if [ -f "$HOSTAPD_PID" ] && kill -0 "$(cat "$HOSTAPD_PID")" 2>/dev/null; then
        kill "$(cat "$HOSTAPD_PID")" 2>/dev/null || true
    fi
    hostapd -B -P "$HOSTAPD_PID" -f /var/log/hostapd.log "$CONF_FILE"
    
    sleep 1
    if [ -f "$HOSTAPD_PID" ] && kill -0 "$(cat "$HOSTAPD_PID")" 2>/dev/null; then
        echo "[SUCCESS] MT7663 Hotspot is active on $AP_IF (SSID: HG680_5G_VHT80, Gateway: 192.168.4.1)"
    else
        echo "[ERROR] Failed to start hostapd. Check /var/log/hostapd.log for details." >&2
        exit 1
    fi
}

stop_hotspot() {
    echo "Stopping MT7663 SoftAP Hotspot..."
    if [ -f "$HOSTAPD_PID" ]; then
        kill "$(cat "$HOSTAPD_PID")" 2>/dev/null || true
        rm -f "$HOSTAPD_PID"
    fi
    killall hostapd 2>/dev/null || true

    if [ -f "$DNSMASQ_PID" ]; then
        kill "$(cat "$DNSMASQ_PID")" 2>/dev/null || true
        rm -f "$DNSMASQ_PID"
    fi

    if ip link show "$AP_IF" >/dev/null 2>&1; then
        ip addr flush dev "$AP_IF" 2>/dev/null || true
        ip link set "$AP_IF" down 2>/dev/null || true
    fi
    echo "[INFO] MT7663 Hotspot stopped."
}

status_hotspot() {
    echo "=== MT7663 Hotspot Status ==="
    if [ -f "$HOSTAPD_PID" ] && kill -0 "$(cat "$HOSTAPD_PID")" 2>/dev/null; then
        echo "Hostapd: RUNNING (PID $(cat "$HOSTAPD_PID"))"
    else
        echo "Hostapd: STOPPED"
    fi

    if [ -f "$DNSMASQ_PID" ] && kill -0 "$(cat "$DNSMASQ_PID")" 2>/dev/null; then
        echo "Dnsmasq: RUNNING (PID $(cat "$DNSMASQ_PID"))"
    else
        echo "Dnsmasq: STOPPED"
    fi

    echo "--- Connected Clients ($AP_IF) ---"
    local found=0
    if [ -f /var/lib/misc/dnsmasq.leases ] && [ -s /var/lib/misc/dnsmasq.leases ]; then
        while read -r ts mac ip name client_id; do
            if [ -n "$ip" ]; then
                local state=$(ip neigh show dev "$AP_IF" "$ip" 2>/dev/null | awk '{print $NF}')
                [ -z "$state" ] && state="ACTIVE"
                echo " - IP: $ip | MAC: $mac | Hostname: $name ($state)"
                found=1
            fi
        done < <(sort -u -k2,2 /var/lib/misc/dnsmasq.leases)
    fi

    if [ "$found" -eq 0 ]; then
        local neigh=$(ip neigh show dev "$AP_IF" 2>/dev/null | grep -E "REACHABLE|DELAY|PROBE|STALE")
        if [ -n "$neigh" ]; then
            while read -r ip _ _ mac _ state; do
                echo " - IP: $ip | MAC: $mac ($state)"
                found=1
            done <<< "$neigh"
        fi
    fi

    if [ "$found" -eq 0 ]; then
        echo "No active clients connected."
    fi
}

case "$1" in
    start)
        start_hotspot
        ;;
    stop)
        stop_hotspot
        ;;
    restart)
        stop_hotspot
        sleep 1
        start_hotspot
        ;;
    status)
        status_hotspot
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
